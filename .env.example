# Runtime mode: set POSTGRES_ENABLED=true when running against PostgreSQL 16 (docker compose up -d postgres)
POSTGRES_ENABLED=false

# Isolated per-service PostgreSQL connection strings (schema-scoped via search_path or Drizzle pgSchema)
PROJECTS_DATABASE_URL=postgres://taskify:taskify_dev_password@localhost:5432/taskify?options=-csearch_path%3Dprojects_domain
TASKS_DATABASE_URL=postgres://taskify:taskify_dev_password@localhost:5432/taskify?options=-csearch_path%3Dtasks_domain
NOTIFICATIONS_DATABASE_URL=postgres://taskify:taskify_dev_password@localhost:5432/taskify?options=-csearch_path%3Dnotifications_domain

# Zero-Trust inter-service shared secret (rotate per environment)
INTERNAL_SERVICE_TOKEN=taskify-internal-dev-token-change-in-prod

# Service endpoints
API_GATEWAY_PORT=3001
PROJECTS_SERVICE_PORT=3002
TASKS_SERVICE_PORT=3003
NOTIFICATIONS_SERVICE_PORT=3004
WEB_APP_PORT=3000

API_GATEWAY_URL=http://localhost:3001
PROJECTS_SERVICE_URL=http://localhost:3002
TASKS_SERVICE_URL=http://localhost:3003
NOTIFICATIONS_SERVICE_URL=http://localhost:3004
CORS_ORIGIN=http://localhost:3000
